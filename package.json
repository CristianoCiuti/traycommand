{
  "name": "traycommand",
  "productName": "TrayCommand",
  "version": "2.7.0",
  "description": "Run shell commands from system tray icons",
  "author": "Cristiano Ciuti",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/main/main.cjs",
  "homepage": "https://cristianociuti.github.io/traycommand/",
  "repository": "github:CristianoCiuti/traycommand",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/build.mjs && electron .",
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "schema": "node scripts/schema.mts",
    "package": "npm run build && electron-builder --publish never",
    "site:dev": "vitepress dev site",
    "site:build": "npm run schema && vitepress build site"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@preact/preset-vite": "^2.10.6",
    "@preact/signals": "^2.11.4",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.1",
    "ajv": "^8.20.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "lucide-preact": "^1.76.0",
    "png-to-ico": "^3.0.2",
    "preact": "^10.29.8",
    "typescript": "~5.9",
    "vite": "^8.3.8",
    "vitepress": "^1.6.4",
    "vitest": "^5.1.1",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "electron@45.4.1": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
